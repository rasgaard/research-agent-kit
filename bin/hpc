#!/usr/bin/env python3
"""Local-first DTU HPC control plane.

Stdlib only. Keeps code on the Mac as the source of truth: every job ships a
`git archive` snapshot pinned to a SHA, so the HPC side needs no GitHub
credentials and runs are reproducible.
"""
from __future__ import annotations

import argparse
import configparser
import getpass
import json
import os
import re
import shlex
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import NoReturn, Optional

DEFAULT_CONFIG = Path.home() / ".config" / "dtu-hpc" / "config.ini"
DEFAULT_REMOTE_ROOT = "/work3/{user}/hpc/{repo}"
DEFAULT_VENV = "/work3/{user}/hpc/venvs/{repo}"
DEFAULT_HF_HOME = "/work3/{user}/hf"
DEFAULT_UV_CACHE = "/work3/{user}/.cache/uv"
DEFAULT_SECRETS = "$HOME/.config/dtu-hpc/secrets.env"
GPU_NODES = {"a100": "a100sh", "v100": "voltash", "sxm2": "sxm2sh"}
P1_GPU_COMMAND = 'export TERM=${TERM:-xterm-256color}; p1gpush'
SUCCESS_STATES = {"DONE"}
FAILURE_PRIORITY = ("EXIT", "KILL", "TERM", "ZOMBI")
FAILURE_STATES = set(FAILURE_PRIORITY)
UNKNOWN_STATES = {"UNKWN"}
TERMINAL_STATES = SUCCESS_STATES | FAILURE_STATES
SUSPENDED_STATES = {"SSUSP", "USUSP", "PSUSP"}
WATCH_TERMINAL_EVENTS = {"completed", "failed", "stalled", "unknown",
                         "monitor_error"}


def config_path() -> Path:
    return Path(os.environ.get("HPC_CONFIG", str(DEFAULT_CONFIG))).expanduser()


def die(message: str, code: int = 1) -> NoReturn:
    print(f"hpc: {message}", file=sys.stderr)
    raise SystemExit(code)


def run(cmd: list[str], **kwargs) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, **kwargs)


def git(*args: str, cwd: Optional[Path] = None, check: bool = True) -> subprocess.CompletedProcess:
    result = run(["git", *args], cwd=cwd, text=True, capture_output=True)
    if check and result.returncode != 0:
        die(result.stderr.strip() or f"git {' '.join(args)} failed")
    return result


def repo_root() -> Path:
    return Path(git("rev-parse", "--show-toplevel").stdout.strip())


def git_dir(root: Path) -> Path:
    return Path(git("rev-parse", "--absolute-git-dir", cwd=root).stdout.strip())


def load_config() -> dict[str, str]:
    config = {
        "host": "dtu",
        "remote_root": DEFAULT_REMOTE_ROOT,
        "venv": DEFAULT_VENV,
        "hf_home": DEFAULT_HF_HOME,
        "uv_cache": DEFAULT_UV_CACHE,
        "secrets": DEFAULT_SECRETS,
    }
    path = config_path()
    if path.exists():
        parser = configparser.ConfigParser()
        parser.read(path)
        if parser.has_section("hpc"):
            for key, value in parser.items("hpc"):
                config[key] = value
    return config


def ssh(host: str, args: list[str], input: Optional[bytes] = None, text: bool = True,
        check: bool = False) -> subprocess.CompletedProcess:
    """Run a remote command and capture its output for parsing."""
    cmd = ["ssh", host, *args]
    kwargs = {"input": input} if input is not None else {"stdin": subprocess.DEVNULL}
    result = run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=text, **kwargs)
    if check and result.returncode != 0:
        err = result.stderr if text else result.stderr.decode(errors="replace")
        die(err.strip() or f"ssh {host} failed")
    return result


def ssh_stream(host: str, args: list[str], tty: bool = False) -> int:
    """Run a remote command with the caller's terminal attached."""
    cmd = ["ssh", *(["-t"] if tty else []), host, *args]
    try:
        return run(cmd).returncode
    except KeyboardInterrupt:
        return 130


def login_command(script: str, args: Optional[list[str]] = None) -> str:
    command = "bash -lc " + shlex.quote(script)
    if args:
        command += " hpc " + " ".join(shlex.quote(arg) for arg in args)
    return command


def ssh_login(host: str, script: str, args: Optional[list[str]] = None,
              **kwargs) -> subprocess.CompletedProcess:
    """Run a remote script in a login shell so LSF (bsub/bstat/bpeek) is on PATH."""
    return ssh(host, [login_command(script, args)], **kwargs)


def ssh_login_stream(host: str, script: str, args: Optional[list[str]] = None,
                     tty: bool = False) -> int:
    """Run a login-shell command with inherited stdin/stdout/stderr."""
    return ssh_stream(host, [login_command(script, args)], tty=tty)


def ssh_login_batch(host: str, script: str,
                    args: Optional[list[str]] = None) -> subprocess.CompletedProcess:
    """Run a login-shell probe without ever prompting for authentication."""
    return ssh_batch(host, [login_command(script, args)])


def socket_alive(host: str) -> bool:
    return run(["ssh", "-O", "check", host], stdin=subprocess.DEVNULL,
               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def ssh_batch(host: str, args: list[str]) -> subprocess.CompletedProcess:
    """Run a remote command without ever prompting for auth."""
    return run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", host, *args],
               stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
               stderr=subprocess.PIPE, text=True)


def dtu_aliases(path: Path) -> list[str]:
    """Return SSH aliases whose Host/HostName points at DTU HPC."""
    if not path.exists():
        return []
    aliases: list[str] = []
    pending: list[str] = []
    hostname = ""

    def flush() -> None:
        nonlocal pending, hostname
        if pending and ("hpc.dtu.dk" in hostname.lower() or
                        any("hpc.dtu.dk" in name.lower() for name in pending)):
            aliases.extend(pending)
        pending = []
        hostname = ""

    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        parts = line.split()
        key = parts[0].lower()
        if key == "host" and len(parts) > 1:
            flush()
            pending = parts[1:]
        elif key == "hostname" and len(parts) > 1:
            hostname = parts[1]
    flush()
    result: list[str] = []
    for alias in aliases:
        if alias != "*" and alias not in result:
            result.append(alias)
    return result


def ensure(host: str, timeout: int = 180) -> None:
    if socket_alive(host):
        return
    if os.environ.get("HPC_NO_OPEN") == "1":
        die(f"no SSH master for {host}; run: ssh -M -N -f {host}")
    command = f"ssh -M -N -f {shlex.quote(host)}"
    if sys.platform == "darwin":
        script = command.replace("\\", "\\\\").replace('"', '\\"')
        run(["osascript",
             "-e", 'tell application "Terminal" to activate',
             "-e", f'tell application "Terminal" to do script "{script}"'])
    else:
        print(f"hpc: authenticate in another terminal: {command}", file=sys.stderr)
    for _ in range(timeout):
        if socket_alive(host):
            print(f"hpc: SSH master for {host} is up", file=sys.stderr)
            return
        time.sleep(1)
    die(f"authentication did not complete; run: {command}")


def remote_env(host: str) -> tuple[str, str]:
    result = ssh(host, ['printf "%s\\n%s\\n" "$USER" "$HOME"'], check=True)
    lines = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    if len(lines) < 2:
        die("could not read $USER/$HOME on the remote host")
    return lines[0], lines[1]


def remote_root(host: str, config: dict[str, str], root: Path) -> str:
    user, home = remote_env(host)
    return config["remote_root"].format(user=user, home=home, repo=root.name)


def ledger_path(root: Path) -> Path:
    return git_dir(root) / "hpc" / "jobs.jsonl"


def append_ledger(root: Path, entry: dict) -> None:
    path = ledger_path(root)
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(entry, sort_keys=True) + "\n")


def read_ledger(root: Path) -> list[dict]:
    path = ledger_path(root)
    if not path.exists():
        return []
    entries = []
    for line in path.read_text(encoding="utf-8").splitlines():
        try:
            entries.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return entries


def find_job(root: Path, job_id: str) -> Optional[dict]:
    for entry in reversed(read_ledger(root)):
        if str(entry.get("job_id")) == str(job_id):
            return entry
    return None


def events_path(root: Path) -> Path:
    return git_dir(root) / "hpc" / "events.jsonl"


def watch_state_path(root: Path) -> Path:
    return git_dir(root) / "hpc" / "watch-state.json"


def events_offset_path(root: Path) -> Path:
    return git_dir(root) / "hpc" / "events.offset"


def read_event_lines(root: Path) -> list[str]:
    path = events_path(root)
    if not path.exists():
        return []
    return path.read_text(encoding="utf-8").splitlines()


def append_event(root: Path, event: dict) -> None:
    path = events_path(root)
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(event, sort_keys=True) + "\n")


def load_watch_state(root: Path) -> dict:
    path = watch_state_path(root)
    if not path.exists():
        return {"jobs": {}}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        return {"jobs": {}}
    if not isinstance(data, dict):
        return {"jobs": {}}
    data.setdefault("jobs", {})
    return data


def save_watch_state(root: Path, state: dict) -> None:
    path = watch_state_path(root)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n",
                    encoding="utf-8")


def parse_bjobs(text: str) -> dict[int, list[str]]:
    """Map a parent job id to the statuses of its elements."""
    jobs: dict[int, list[str]] = {}
    for line in text.splitlines():
        parts = line.split()
        if len(parts) < 3:
            continue
        match = re.fullmatch(r"(\d+)(?:\[\d+\])?", parts[0])
        if not match:
            continue
        jobs.setdefault(int(match.group(1)), []).append(parts[2].upper())
    return jobs


def summarize_states(states: list[str]) -> str:
    if not states:
        return "UNKNOWN"
    for state in FAILURE_PRIORITY:
        if state in states:
            return state
    if any(state == "RUN" for state in states):
        return "RUN"
    if any(state == "PEND" for state in states):
        return "PEND"
    if any(state in SUSPENDED_STATES for state in states):
        return "SUSP"
    if all(state == "DONE" for state in states):
        return "DONE"
    if any(state in UNKNOWN_STATES for state in states):
        return "UNKWN"
    return states[0]


def failure_detail(states: list[str], status: str) -> str:
    if len(states) <= 1:
        return f"status {status}"
    counts = ", ".join(f"{state}={states.count(state)}"
                       for state in FAILURE_PRIORITY if state in states)
    failed = sum(states.count(state) for state in FAILURE_STATES)
    return f"{failed}/{len(states)} array elements failed ({counts})"


def states_are_terminal(states: list[str]) -> bool:
    return bool(states) and all(state in TERMINAL_STATES for state in states)


def parse_timestamp(value: object) -> Optional[datetime]:
    if not isinstance(value, str) or not value:
        return None
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed


def parse_log_stats(text: str) -> Optional[tuple[float, int]]:
    latest: Optional[tuple[float, int]] = None
    for line in text.splitlines():
        parts = line.split()
        if len(parts) < 2:
            continue
        try:
            mtime, size = float(parts[0]), int(parts[1])
        except ValueError:
            continue
        if latest is None or mtime > latest[0]:
            latest = (mtime, size)
    return latest


def job_is_recent(entry: dict, now: datetime, lookback_hours: int) -> bool:
    if lookback_hours <= 0:
        return True
    submitted = parse_timestamp(entry.get("submitted_at"))
    if submitted is None:
        return True
    return (now - submitted).total_seconds() <= lookback_hours * 3600


def make_event(entry: dict, kind: str, status: str, detail: str,
               now: datetime, **extra: object) -> dict:
    event = {
        "timestamp": now.isoformat(),
        "job_id": entry.get("job_id"),
        "run_id": entry.get("run_id"),
        "event": kind,
        "status": status,
        "detail": detail,
    }
    event.update(extra)
    return event


def collect_watch_events(host: str, entries: list[dict], state: dict,
                         now: datetime, stall_seconds: int,
                         lookback_hours: int) -> list[dict]:
    events: list[dict] = []
    result = ssh_login_batch(host, "bjobs -w -a 2>/dev/null")
    if result.returncode != 0:
        error = result.stderr.strip() or f"bjobs failed with exit code {result.returncode}"
        if not state.get("last_error"):
            events.append({
                "timestamp": now.isoformat(),
                "event": "monitor_error",
                "status": "UNKNOWN",
                "detail": error,
            })
        state["last_error"] = error
        return events
    if state.get("last_error"):
        events.append({
            "timestamp": now.isoformat(),
            "event": "monitor_recovered",
            "status": "OK",
            "detail": "bjobs is reachable again",
        })
        state.pop("last_error", None)

    statuses = parse_bjobs(result.stdout)
    jobs = state.setdefault("jobs", {})
    for entry in entries:
        try:
            job_id = int(entry["job_id"])
        except (KeyError, TypeError, ValueError):
            continue
        key = str(job_id)
        previous = jobs.get(key, {})
        if previous.get("terminal"):
            continue
        if key not in jobs and not job_is_recent(entry, now, lookback_hours):
            continue

        raw_states = statuses.get(job_id, [])
        status = summarize_states(raw_states)
        terminal = states_are_terminal(raw_states)
        before = previous.get("status")

        if status != before:
            if status == "DONE" and terminal:
                kind = "completed"
            elif status in FAILURE_STATES:
                kind = "failed"
            elif status in UNKNOWN_STATES or status == "UNKNOWN":
                kind = "unknown"
            else:
                kind = "state"
            if previous or kind in {"completed", "failed", "unknown"}:
                detail = (failure_detail(raw_states, status)
                          if kind == "failed" else f"status {status}")
                events.append(make_event(entry, kind, status, detail, now))
            previous["status"] = status
            previous["stalled"] = False
        previous["terminal"] = terminal

        if status == "RUN" and stall_seconds > 0 and entry.get("run_dir"):
            log_result = ssh_login_batch(
                host,
                'find "$1" -maxdepth 1 -type f -name "$2*" -printf "%T@ %s\\n" 2>/dev/null',
                [str(entry["run_dir"]) + "/logs", key])
            if log_result.returncode == 0:
                stats = parse_log_stats(log_result.stdout)
                if stats is not None:
                    log_age = max(0.0, now.timestamp() - stats[0])
                    if log_age >= stall_seconds and not previous.get("stalled"):
                        events.append(make_event(
                            entry, "stalled", status,
                            f"log unchanged for {int(log_age // 60)}m", now,
                            log_age_s=int(log_age)))
                        previous["stalled"] = True
                    elif log_age < stall_seconds and previous.get("stalled"):
                        events.append(make_event(
                            entry, "resumed", status, "log is growing again", now,
                            log_age_s=int(log_age)))
                        previous["stalled"] = False
                    previous["last_log_mtime"] = stats[0]

        jobs[key] = previous

    return events


def format_event(event: dict) -> str:
    stamp = str(event.get("timestamp", "")).replace("T", " ")[:19]
    job_id = event.get("job_id")
    prefix = f"job {job_id}" if job_id is not None else "watcher"
    return (f"{stamp} {prefix} {event.get('event', 'event')} "
            f"({event.get('status', '?')}) {event.get('detail', '')}").rstrip()


def notify_event(event: dict) -> None:
    if sys.platform != "darwin":
        return
    message = format_event(event)
    script = f'display notification {json.dumps(message)} with title "DTU HPC"'
    try:
        run(["osascript", "-e", script], stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL)
    except OSError:
        pass


def emit_event(root: Path, event: dict, notify: bool) -> None:
    append_event(root, event)
    print(format_event(event), flush=True)
    if notify and event.get("event") in WATCH_TERMINAL_EVENTS:
        notify_event(event)


def cmd_watch(host: str, args: argparse.Namespace) -> int:
    root = repo_root()
    entries = read_ledger(root)
    if not entries:
        print("hpc: no jobs in ledger", file=sys.stderr)
        return 0
    ensure(host)
    state = load_watch_state(root)
    if args.once:
        print(f"hpc: checking {len(entries)} ledger job(s) once", file=sys.stderr)
    else:
        print(f"hpc: watching {len(entries)} ledger job(s) every {args.interval}s; "
              f"events: {events_path(root)}", file=sys.stderr)
    try:
        while True:
            now = datetime.now(timezone.utc)
            events = collect_watch_events(
                host, entries, state, now,
                max(0, args.stall_minutes) * 60, args.lookback_hours)
            for event in events:
                emit_event(root, event, args.notify)
            save_watch_state(root, state)
            if args.once:
                break
            time.sleep(max(1, args.interval))
    except KeyboardInterrupt:
        print("hpc: watcher stopped", file=sys.stderr)
    return 0


def cmd_events(_host: str, args: argparse.Namespace) -> int:
    root = repo_root()
    lines = read_event_lines(root)
    if args.all:
        selected = list(enumerate(lines))
        offset = len(lines)
    else:
        path = events_offset_path(root)
        try:
            offset = int(path.read_text(encoding="utf-8").strip())
        except (FileNotFoundError, ValueError):
            offset = 0
        offset = min(max(offset, 0), len(lines))
        selected = list(enumerate(lines[offset:], start=offset))
    if not selected:
        print("hpc: no events", file=sys.stderr)
        return 0
    for _index, line in selected:
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if args.json:
            print(json.dumps(event, sort_keys=True))
        else:
            print(format_event(event))
    if not args.all and not args.peek:
        events_offset_path(root).parent.mkdir(parents=True, exist_ok=True)
        events_offset_path(root).write_text(f"{len(lines)}\n", encoding="utf-8")
    return 0


def render(text: str, values: dict[str, str]) -> str:
    for key, value in values.items():
        text = text.replace("{{" + key + "}}", value)
    return text


def render_values(config: dict[str, str], root: Path, workdir: str, run_dir: str,
                  sha: str, job_name: str, user: str = "<user>",
                  home: str = "<home>") -> dict[str, str]:
    fields = {"user": user, "home": home, "repo": root.name}

    def remote(key: str, default: str) -> str:
        return config.get(key, default).format(**fields)

    return {
        "CODE_DIR": workdir,
        "RUN_DIR": run_dir,
        "SHA": sha,
        "JOB_NAME": job_name,
        "VENV": remote("venv", DEFAULT_VENV),
        "HF_HOME": remote("hf_home", DEFAULT_HF_HOME),
        "UV_CACHE": remote("uv_cache", DEFAULT_UV_CACHE),
        "SECRETS": remote("secrets", DEFAULT_SECRETS),
    }


def ship_snapshot(host: str, root: Path, sha: str, destination: str) -> None:
    """Stream `git archive <sha>` into a remote directory."""
    ssh(host, [f"mkdir -p {shlex.quote(destination)}"], check=True)
    archive = subprocess.Popen(["git", "archive", "--format=tar.gz", sha], cwd=root,
                               stdout=subprocess.PIPE)
    extract = run(["ssh", host, f"tar -xzf - -C {shlex.quote(destination)}"],
                  stdin=archive.stdout, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    archive.stdout.close()
    archive.wait()
    if archive.returncode != 0 or extract.returncode != 0:
        die(extract.stderr.decode(errors="replace").strip() or "failed to ship code snapshot")


def merge_env(text: str, name: str, value: str) -> str:
    """Return env-file text with NAME set, preserving unrelated lines."""
    lines = [line for line in text.splitlines() if line.strip()]
    output: list[str] = []
    found = False
    for line in lines:
        if line.lstrip().startswith("#") or "=" not in line:
            output.append(line)
            continue
        key = line.split("=", 1)[0].strip()
        if key == name:
            output.append(f"{name}={value}")
            found = True
        else:
            output.append(line)
    if not found:
        output.append(f"{name}={value}")
    return "\n".join(output) + "\n"


def extract_queue(text: str) -> str:
    match = re.search(r"^#BSUB\s+-q\s+(\S+)", text, re.MULTILINE)
    return match.group(1) if match else "default"


def apply_queue(text: str, queue: Optional[str]) -> str:
    if not queue:
        return text
    if re.search(r"^#BSUB\s+-q\s+\S+", text, re.MULTILINE):
        return re.sub(r"^#BSUB\s+-q\s+\S+", f"#BSUB -q {queue}", text,
                      count=1, flags=re.MULTILINE)
    lines = text.splitlines()
    index = 1 if lines and lines[0].startswith("#!") else 0
    lines.insert(index, f"#BSUB -q {queue}")
    return "\n".join(lines) + ("\n" if text.endswith("\n") else "")


BSUB_JOB = re.compile(r'^#BSUB\s+-J\s+("[^"]*"|\S+)', re.MULTILINE)


def bsub_job_name(text: str) -> Optional[str]:
    match = BSUB_JOB.search(text)
    return match.group(1).strip('"') if match else None


def uncapped_array(text: str) -> Optional[str]:
    """Return the array job name when it has no %K concurrency cap."""
    name = bsub_job_name(text)
    if not name or "[" not in name:
        return None
    if "]" not in name or "%" not in name.split("]", 1)[1]:
        return name
    return None


def lint_submit(text: str, queue_override: Optional[str], allow_uncapped: bool,
                dry_run: bool) -> None:
    name = uncapped_array(text)
    if name:
        example = f"{name}%2"
        message = (f"uncapped array '{name}': add a concurrency cap, e.g. "
                   f"'{example}', or pass --allow-uncapped")
        if dry_run:
            print(f"hpc: warning: {message}", file=sys.stderr)
        elif not allow_uncapped:
            die(message)
        else:
            print(f"hpc: warning: allowing {message}", file=sys.stderr)
    if queue_override:
        original = extract_queue(text)
        if original not in {"default", queue_override}:
            print(f"hpc: warning: --queue {queue_override} overrides script queue "
                  f"{original}", file=sys.stderr)


def cmd_login(host: str, _args: argparse.Namespace) -> int:
    ensure(host)
    print(f"hpc: authenticated to {host} (multiplexed)")
    return 0


def cmd_ensure(host: str, args: argparse.Namespace) -> int:
    ensure(host, timeout=args.timeout)
    return 0


def cmd_init(_host: str, args: argparse.Namespace) -> int:
    path = config_path()
    if path.exists() and not args.force:
        die(f"config already exists: {path} (pass --force to overwrite)")
    aliases = dtu_aliases(Path.home() / ".ssh" / "config")
    if not aliases and not args.ssh_host:
        print("hpc: no DTU SSH alias found in ~/.ssh/config", file=sys.stderr)
        print("hpc: add one (example), or rerun with --ssh-host <alias>:",
              file=sys.stderr)
        print("  Host dtu\n    HostName login9.hpc.dtu.dk\n    User <you>",
              file=sys.stderr)
        return 1
    chosen = args.ssh_host or aliases[0]
    if len(aliases) > 1 and not args.ssh_host:
        print(f"hpc: DTU aliases: {', '.join(aliases)}; using {chosen}",
              file=sys.stderr)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        "[hpc]\n"
        f"host = {chosen}\n"
        f"remote_root = {DEFAULT_REMOTE_ROOT}\n"
        f"venv = {DEFAULT_VENV}\n"
        f"hf_home = {DEFAULT_HF_HOME}\n"
        f"uv_cache = {DEFAULT_UV_CACHE}\n"
        f"secrets = {DEFAULT_SECRETS}\n",
        encoding="utf-8",
    )
    print(f"hpc: wrote {path}")
    print(f"hpc: ssh host = {chosen}")
    if chosen not in aliases:
        print(f"hpc: note: '{chosen}' is not in ~/.ssh/config; add a Host entry "
              "or rerun with --ssh-host <alias>", file=sys.stderr)
    bin_dir = Path.home() / ".local" / "bin"
    if str(bin_dir) not in os.environ.get("PATH", "").split(os.pathsep):
        print(f"hpc: warning: {bin_dir} is not on PATH", file=sys.stderr)
    print("hpc: next → hpc login        (opens Terminal; DTU password required)")
    print("hpc:        hpc sync-env     (once; builds the shared venv)")
    print("hpc:        hpc doctor")
    return 0


def cmd_sync_env(host: str, args: argparse.Namespace) -> int:
    root = repo_root()
    dirty = git("status", "--porcelain", cwd=root).stdout.strip()
    if dirty and not args.allow_dirty:
        die("working tree is dirty; commit (or pass --allow-dirty) before syncing")
    if dirty:
        print("hpc: warning: syncing HEAD; uncommitted edits are not shipped",
              file=sys.stderr)
    sha = git("rev-parse", "HEAD", cwd=root).stdout.strip()
    ensure(host)
    config = load_config()
    user, home = remote_env(host)
    base = config["remote_root"].format(user=user, home=home, repo=root.name)
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    destination = f"{base}/env/{stamp}-{sha[:8]}"
    ship_snapshot(host, root, sha, destination)
    values = render_values(config, root, destination, destination, sha, "sync-env",
                           user, home)
    venv, cache = values["VENV"], values["UV_CACHE"]
    print(f"hpc: syncing {venv} from {sha[:8]} (first run downloads torch)", file=sys.stderr)
    script = ('module load python3/3.11.9 2>/dev/null || true; cd "$1" && '
              'export PATH="$HOME/.local/bin:$PATH" UV_PYTHON_DOWNLOADS=never '
              'UV_PROJECT_ENVIRONMENT="$2" UV_CACHE_DIR="$3" && '
              'uv sync --frozen --python "$(command -v python3)"')
    result = ssh_login(host, script, [destination, venv, cache], check=False)
    if result.returncode != 0:
        sys.stderr.write(result.stderr)
        die("uv sync failed")
    print(f"hpc: venv ready: {venv}")
    print("hpc: next → hpc doctor   |   hpc submit <job.lsf>")
    return 0


SECRET_NAME = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")


EXPAND_PATH = r'f="$1"; f="${f/#\~/$HOME}"; f="${f/#\$HOME/$HOME}"'


def remote_read(host: str, path: str) -> str:
    result = ssh_login(host, EXPAND_PATH + '; test -f "$f" && cat "$f" || true',
                       [path], check=False)
    return result.stdout


def cmd_secret_set(host: str, args: argparse.Namespace) -> int:
    if not SECRET_NAME.match(args.name):
        die(f"invalid secret name: {args.name}")
    if args.file:
        value = Path(args.file).expanduser().read_text(encoding="utf-8").rstrip("\n")
    elif sys.stdin.isatty():
        value = getpass.getpass(f"{args.name}: ").rstrip("\n")
    else:
        value = sys.stdin.read().rstrip("\n")
    if not value.strip():
        die("empty value; pipe it on stdin or pass --file")
    if "\n" in value:
        die("secret value must be a single line")
    path = load_config().get("secrets", DEFAULT_SECRETS)
    if args.dry_run:
        print(f"hpc: would set {args.name} in {path} on {host} (no value shown)")
        return 0
    ensure(host)
    merged = merge_env(remote_read(host, path), args.name, shlex.quote(value))
    script = (EXPAND_PATH + '; umask 077; mkdir -p "$(dirname "$f")"; '
              'cat > "$f"; chmod 600 "$f"')
    ssh_login(host, script, [path], input=merged, check=True)
    print(f"hpc: set {args.name} in {path} on {host} (mode 600)")
    return 0


def cmd_secret_list(host: str, _args: argparse.Namespace) -> int:
    ensure(host)
    path = load_config().get("secrets", DEFAULT_SECRETS)
    names = [line.split("=", 1)[0].strip()
             for line in remote_read(host, path).splitlines()
             if "=" in line and not line.lstrip().startswith("#")]
    print("\n".join(names) if names else "(no secrets)")
    return 0


def cmd_shell(host: str, args: argparse.Namespace) -> int:
    ensure(host)
    print("hpc: shared CPU node via linuxsh (not the login node); tmux session "
          f"'{args.session}'", file=sys.stderr)
    return ssh_login_stream(host, 'tmux new -A -s "$1" linuxsh',
                            [args.session], tty=True)


def cmd_gpu(host: str, args: argparse.Namespace) -> int:
    ensure(host)
    session = f"gpu-{args.kind}"
    if args.kind == "p1":
        print(f"hpc: p1gpush (2 shared H100s; short tests only) in tmux '{session}'",
              file=sys.stderr)
        return ssh_login_stream(host, 'tmux new -A -s "$1" bash -lc "$2"',
                                [session, P1_GPU_COMMAND], tty=True)
    command = GPU_NODES[args.kind]
    print(f"hpc: {command} (shared node; short tests only) in tmux '{session}'", file=sys.stderr)
    return ssh_login_stream(host, 'tmux new -A -s "$1" "$2"',
                            [session, command], tty=True)


def cmd_stage(host: str, args: argparse.Namespace) -> int:
    root = repo_root()
    dirty = git("status", "--porcelain", cwd=root).stdout.strip()
    if dirty and not args.allow_dirty:
        die("working tree is dirty; commit (or pass --allow-dirty) before staging")
    if dirty:
        print("hpc: warning: staging HEAD; uncommitted edits are not shipped", file=sys.stderr)
    sha = git("rev-parse", "HEAD", cwd=root).stdout.strip()
    ensure(host)
    base = remote_root(host, load_config(), root)
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    destination = f"{base}/interactive/{stamp}-{sha[:8]}"
    ship_snapshot(host, root, sha, destination)
    current = f"{base}/interactive/current"
    ssh(host, [f"ln -sfn {shlex.quote(destination)} {shlex.quote(current)}"], check=True)
    print(f"hpc: staged {sha[:8]} → {destination}")
    print(f"hpc: current → {current}")
    print("hpc: next → hpc shell        (CPU, linuxsh)")
    print("hpc:        hpc gpu a100     (GPU, shared debug node)")
    print(f"hpc:        cd {current} && python -u your_script.py")
    return 0


def cmd_submit(host: str, args: argparse.Namespace) -> int:
    root = repo_root()
    script = Path(args.script)
    if not script.exists():
        die(f"job script not found: {script}")
    dirty = git("status", "--porcelain", cwd=root).stdout.strip()
    sha = git("rev-parse", "HEAD", cwd=root).stdout.strip()
    branch = git("rev-parse", "--abbrev-ref", "HEAD", cwd=root).stdout.strip()

    job_name = args.name or script.stem
    source = script.read_text(encoding="utf-8")

    if not args.dry_run:
        if dirty and not args.allow_dirty:
            die("working tree is dirty; commit (or push a WIP commit) before submitting")
        if dirty:
            print("hpc: warning: submitting a dirty tree; the snapshot is HEAD, not your edits",
                  file=sys.stderr)
        if branch == "HEAD" and not args.allow_dirty:
            die("detached HEAD; check out a branch before submitting")

    lint_submit(source, args.queue, args.allow_uncapped, args.dry_run)

    if args.dry_run:
        if dirty:
            print("hpc: warning: dirty tree; preview shows HEAD, not your edits",
                  file=sys.stderr)
        stamps = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        run_id = f"{stamps}-{sha[:8]}"
        base = load_config()["remote_root"].format(
            user="<user>", home="<home>", repo=root.name)
        workdir = f"{base}/jobs/{run_id}/code"
        run_dir = f"{base}/jobs/{run_id}"
        rendered = apply_queue(render(source, render_values(
            load_config(), root, workdir, run_dir, sha, job_name)), args.queue)
        print(f"hpc: git archive --format=tar.gz {sha} | ssh {host} tar -xzf - -C {workdir}")
        print(f"hpc: ssh {host} 'cat > {run_dir}/job.lsf'")
        print(f"hpc: ssh {host} 'cd {run_dir} && bsub < job.lsf'")
        print("--- rendered job script ---")
        print(rendered)
        return 0

    ensure(host)
    config = load_config()
    user, home = remote_env(host)
    base = config["remote_root"].format(user=user, home=home, repo=root.name)
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    run_id = f"{stamp}-{sha[:8]}"
    run_dir = f"{base}/jobs/{run_id}"
    workdir = f"{run_dir}/code"
    logdir = f"{run_dir}/logs"
    ssh(host, [f"mkdir -p {shlex.quote(workdir)} {shlex.quote(logdir)}"], check=True)
    ship_snapshot(host, root, sha, workdir)

    rendered = apply_queue(render(source, render_values(
        config, root, workdir, run_dir, sha, job_name, user, home)), args.queue)
    remote_script = f"{run_dir}/job.lsf"
    ssh(host, [f"cat > {shlex.quote(remote_script)}"], input=rendered, check=True)
    result = ssh_login(host, 'cd "$1" && bsub < "$2"', [run_dir, remote_script],
                       check=True)
    match = re.search(r"Job <(\d+)>", result.stdout + result.stderr)
    if not match:
        die(f"could not parse job id from bsub output:\n{result.stdout}{result.stderr}")
    job_id = int(match.group(1))
    entry = {
        "job_id": job_id,
        "run_id": run_id,
        "sha": sha,
        "branch": branch,
        "script": str(script),
        "queue": extract_queue(rendered),
        "run_dir": run_dir,
        "workdir": workdir,
        "submitted_at": datetime.now(timezone.utc).isoformat(),
    }
    append_ledger(root, entry)
    print(f"hpc: submitted job {job_id} ({entry['queue']}) from {branch}@{sha[:8]}")
    print(f"hpc: run dir {run_dir}")
    print(f"hpc: next → hpc logs {job_id} -f   |   hpc pull {job_id}")
    return 0


def cmd_status(host: str, args: argparse.Namespace) -> int:
    ensure(host)
    if args.job_id:
        script = ('if command -v bstat >/dev/null 2>&1; then bstat "$1"; '
                  'else bjobs -w "$1"; fi')
    else:
        script = ('if command -v bjobs >/dev/null 2>&1; then bjobs -w; '
                  'else bstat; fi')
    result = ssh_login(host, script, [args.job_id] if args.job_id else [], check=False)
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    return result.returncode


def log_file_names(names: list[str], job_id: str, index: Optional[int]) -> list[str]:
    prefix = re.compile(rf"^{re.escape(str(job_id))}(?:$|[-_.])")
    selected = [name for name in names
                if prefix.match(name) and name.endswith((".out", ".err"))]
    if index is not None:
        indexed = re.compile(rf"(?:^|[-_.])0*{index}\.(?:out|err)$")
        selected = [name for name in selected if indexed.search(name)]
    return sorted(selected)


def cmd_logs(host: str, args: argparse.Namespace) -> int:
    ensure(host)
    root = repo_root()
    entry = find_job(root, args.job_id)
    if not entry:
        if args.follow or args.index is not None:
            die(f"job {args.job_id} not in the local ledger; cannot locate its logs")
        return ssh_login_stream(host, 'exec bpeek "$1"', [args.job_id])

    logdir = f"{entry['run_dir']}/logs"
    result = ssh_login(
        host, 'find "$1" -maxdepth 1 -type f -name "$2*" -printf "%f\\n"',
        [logdir, str(args.job_id)], check=False)
    if result.returncode != 0:
        die(f"could not list logs in {logdir}: {result.stderr.strip()}")
    names = log_file_names(result.stdout.splitlines(), args.job_id, args.index)
    if not names:
        hint = f" (index {args.index})" if args.index is not None else ""
        die(f"no logs{hint} found under {logdir}; "
            f"the job may still be starting (retry, or run hpc status {args.job_id})")
    files = [f"{logdir}/{name}" for name in names]
    print(f"hpc: logs {', '.join(names)}", file=sys.stderr)
    if args.follow:
        return ssh_login_stream(host, 'tail -F "$@"', files)
    return ssh_login_stream(host, 'tail -n 50 "$@"', files)


def cmd_pull(host: str, args: argparse.Namespace) -> int:
    ensure(host)
    root = repo_root()
    entry = find_job(root, args.job_id) if args.job_id else None
    if not entry:
        die(f"job {args.job_id or ''} not in the local ledger; pass a job id from hpc submit")
    destination = Path(args.dest).expanduser() if args.dest else root / "runs" / entry["run_id"]
    destination.mkdir(parents=True, exist_ok=True)
    command = ["rsync", "-az", "--partial"]
    if not args.include_code:
        command.append("--exclude=/code/")
    command.extend([f"{host}:{entry['run_dir']}/", f"{destination}/"])
    result = run(command)
    if result.returncode != 0:
        die(f"rsync failed with exit code {result.returncode}")
    if not args.include_code:
        print("hpc: excluded code/ (use --include-code to include it)",
              file=sys.stderr)
    print(f"hpc: pulled {entry['run_dir']} → {destination}")
    return 0


def print_checks(checks: list[tuple[str, bool, str]]) -> None:
    for label, ok, note in checks:
        print(f"{'ok  ' if ok else 'FAIL'}  {label:<28} {note}")


def cmd_doctor(host: str, _args: argparse.Namespace) -> int:
    root = repo_root()
    config = load_config()
    checks: list[tuple[str, bool, str]] = []
    for name in ("git", "ssh", "rsync"):
        checks.append((name, bool(shutil_which(name)), "local binary"))
    if not socket_alive(host):
        checks.append(("ssh master", False, f"no live socket — run: hpc login ({host})"))
        print_checks(checks)
        return 1
    checks.append(("ssh master", True, f"ssh -O check {host}"))
    probe = ssh_batch(host, ["true"])
    if probe.returncode != 0:
        checks.append(("remote auth", False, "socket stale — run: hpc login"))
        print_checks(checks)
        return 1
    checks.append(("remote auth", True, "non-interactive probe"))
    user, home = remote_env(host)
    checks.append(("remote user", bool(user), user))
    base = remote_root(host, config, root)
    result = ssh(host, [f"test -d {shlex.quote(base)} || mkdir -p {shlex.quote(base)}"])
    checks.append((f"remote root {base}", result.returncode == 0, "writable"))
    for name in ("bsub", "bstat", "rsync", "uv"):
        probe = ssh_login(host, f"command -v {name} >/dev/null 2>&1")
        checks.append((f"remote {name}", probe.returncode == 0, "on PATH"))
    venv = render_values(config, root, "", "", "", "", user, home)["VENV"]
    probe = ssh_login(host, 'test -x "$1/bin/python"', [venv])
    checks.append((f"venv {venv}", probe.returncode == 0,
                   "synced" if probe.returncode == 0 else "missing — run: hpc sync-env"))
    secrets = config.get("secrets", DEFAULT_SECRETS)
    probe = ssh_login(host, EXPAND_PATH + '; test -f "$f" && stat -c %a "$f"',
                      [secrets])
    if probe.returncode == 0:
        mode = probe.stdout.strip()
        checks.append(("remote secrets", mode in {"600", "400"},
                       f"{secrets} (mode {mode})"))
    else:
        checks.append(("remote secrets", True,
                       f"missing (optional) — hpc secret set NAME ({secrets})"))
    print_checks(checks)
    return 0 if all(ok for _, ok, _ in checks) else 1


def shutil_which(name: str) -> Optional[str]:
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        candidate = Path(directory) / name
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    return None


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="hpc", description="DTU LSF control plane")
    parser.add_argument("--host", default=None, help="SSH host alias (default: config or 'dtu')")
    sub = parser.add_subparsers(dest="command", required=True)

    login = sub.add_parser("login", help="establish/reuse the SSH master socket")
    login.set_defaults(func=cmd_login)

    ensure_parser = sub.add_parser("ensure", help="make sure the master socket is alive")
    ensure_parser.add_argument("--timeout", type=int, default=180)
    ensure_parser.set_defaults(func=cmd_ensure)

    init = sub.add_parser("init", help="write the local config (run once)")
    init.add_argument("--ssh-host", default=None, help="SSH alias to store")
    init.add_argument("--force", action="store_true")
    init.set_defaults(func=cmd_init)

    sync_env = sub.add_parser("sync-env", help="ship HEAD and uv sync the shared venv")
    sync_env.add_argument("--allow-dirty", action="store_true")
    sync_env.set_defaults(func=cmd_sync_env)

    secret = sub.add_parser("secret", help="manage the remote secrets env file")
    secret_sub = secret.add_subparsers(dest="secret_command", required=True)
    secret_set = secret_sub.add_parser("set", help="set a key (stdin, prompt, or --file)")
    secret_set.add_argument("name")
    secret_set.add_argument("--file", default=None)
    secret_set.add_argument("--dry-run", action="store_true")
    secret_set.set_defaults(func=cmd_secret_set)
    secret_list = secret_sub.add_parser("list", help="list key names (never values)")
    secret_list.set_defaults(func=cmd_secret_list)

    shell = sub.add_parser("shell", help="shared CPU node (linuxsh) in tmux")
    shell.add_argument("--session", default="hpc")
    shell.set_defaults(func=cmd_shell)

    gpu = sub.add_parser("gpu", help="interactive GPU node in tmux")
    gpu.add_argument("kind", choices=sorted([*GPU_NODES, "p1"]))
    gpu.set_defaults(func=cmd_gpu)

    stage = sub.add_parser("stage", help="ship HEAD to /work3 for interactive testing")
    stage.add_argument("--allow-dirty", action="store_true")
    stage.set_defaults(func=cmd_stage)

    submit = sub.add_parser("submit", help="ship HEAD and submit an LSF job")
    submit.add_argument("script")
    submit.add_argument("--name", default=None)
    submit.add_argument("--queue", default=None, help="override the script's #BSUB -q")
    submit.add_argument("--allow-dirty", action="store_true")
    submit.add_argument("--allow-uncapped", action="store_true",
                        help="allow an array without a %K concurrency cap")
    submit.add_argument("--dry-run", action="store_true")
    submit.set_defaults(func=cmd_submit)

    status = sub.add_parser("status", help="bjobs for all jobs, bstat for one")
    status.add_argument("job_id", nargs="?")
    status.set_defaults(func=cmd_status)

    logs = sub.add_parser("logs", help="bpeek or tail the job logs")
    logs.add_argument("job_id")
    logs.add_argument("-f", "--follow", action="store_true")
    logs.add_argument("--index", type=int, default=None,
                      help="select one array element")
    logs.set_defaults(func=cmd_logs)

    pull = sub.add_parser("pull", help="rsync a run directory back")
    pull.add_argument("job_id", nargs="?")
    pull.add_argument("--dest", default=None)
    pull.add_argument("--include-code", action="store_true",
                      help="also pull the code/ snapshot")
    pull.set_defaults(func=cmd_pull)

    watch = sub.add_parser("watch", help="poll ledger jobs and record events")
    watch.add_argument("--once", action="store_true")
    watch.add_argument("--interval", type=int, default=60)
    watch.add_argument("--stall-minutes", type=int, default=30,
                       help="emit a stall when a RUN log is older than this (0 disables)")
    watch.add_argument("--lookback-hours", type=int, default=24,
                       help="ignore ledger jobs older than this on first sight (0 = all)")
    watch.add_argument("--notify", action="store_true",
                       help="send macOS notifications for terminal/stall events")
    watch.set_defaults(func=cmd_watch)

    events = sub.add_parser("events", help="print watcher events for the agent")
    events.add_argument("--unread", action="store_true",
                        help="print unread events (default)")
    events.add_argument("--all", action="store_true")
    events.add_argument("--json", action="store_true")
    events.add_argument("--peek", action="store_true",
                        help="do not advance the unread offset")
    events.set_defaults(func=cmd_events)

    doctor = sub.add_parser("doctor", help="check local/remote prerequisites")
    doctor.set_defaults(func=cmd_doctor)
    return parser


def main(argv: Optional[list[str]] = None) -> int:
    args = build_parser().parse_args(argv)
    host = args.host or load_config().get("host", "dtu")
    return args.func(host, args)


if __name__ == "__main__":
    raise SystemExit(main())
