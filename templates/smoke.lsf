#!/bin/sh
# Plumbing pilot: proves code shipping, GPU allocation, and log/result pull.
#BSUB -q gpua100
#BSUB -J smoke
#BSUB -n 4
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -R "rusage[mem=8GB]"
#BSUB -M 8GB
#BSUB -W 0:10
#BSUB -o {{RUN_DIR}}/logs/%J.out
#BSUB -e {{RUN_DIR}}/logs/%J.err

set -euo pipefail
cd "{{CODE_DIR}}"
echo "sha={{SHA}} job=$LSB_JOBID host=$(hostname)"
nvidia-smi
python3 - <<'PY'
try:
    import torch
    print("torch", torch.__version__, "cuda", torch.cuda.is_available())
    if torch.cuda.is_available():
        print("device", torch.cuda.get_device_name(0))
except Exception as exc:
    print("torch unavailable:", exc)
PY
echo "PILOT OK"
